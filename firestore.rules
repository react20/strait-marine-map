rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can read and write only their own settings
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Live location sharing (opt-in): any signed-in person can see who is sharing;
    // each person can only write or delete their own position.
    match /live/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'acc', 'sog', 'cog', 't'])
        && request.resource.data.lat is number && request.resource.data.lat >= 48 && request.resource.data.lat <= 51
        && request.resource.data.lng is number && request.resource.data.lng >= -126 && request.resource.data.lng <= -121
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.t == request.time;
    }
    // Messages between signed-in users: only the sender and the recipient can read them.
    // "Everyone nearby" sends one copy per boat, tagged with a shared bc id.
    // The sender writes a new message; the recipient can only flip "read" to true; either can delete.
    match /msgs/{id} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'text', 'read', 't', 'bc', 'photo'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && (request.resource.data.text.size() > 0 || ('photo' in request.resource.data && request.resource.data.photo is string))
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 40
        && request.resource.data.read == false
        && (!('bc' in request.resource.data) || (request.resource.data.bc is string && request.resource.data.bc.size() <= 40))
        && request.resource.data.t == request.time;
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Photos sent in messages: stored once, readable only by the sender and the boats it was sent to
    match /photos/{id} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid || request.auth.uid in resource.data.to);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'to', 'data', 't'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is list && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 100
        && request.resource.data.data is string && request.resource.data.data.size() <= 950000
        && request.resource.data.t == request.time;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
  }
}
